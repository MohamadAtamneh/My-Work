# Firebase Configuration
# Get these values from your Firebase Console > Project Settings
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK credentials — PREFERRED: the full service-account JSON on one line
# (Firebase Console > Project Settings > Service Accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id","private_key":"...","client_email":"..."}
# Alternative: absolute path to the JSON key file (keep it out of git!)
# FIREBASE_SERVICE_ACCOUNT_PATH=/secure/path/service-account.json

# Backend Configuration
PORT=4001

# Comma-separated frontend origins allowed by CORS
CLIENT_URL=http://localhost:5173

# Comma-separated emails that should be granted the "admin" role on login
ADMIN_EMAILS=your-email@example.com

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:4001/api/payments/webhook` in dev,
# or the webhook endpoint's signing secret in the Stripe Dashboard for production
STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry error monitoring (optional — leave empty to disable)
SENTRY_DSN=
